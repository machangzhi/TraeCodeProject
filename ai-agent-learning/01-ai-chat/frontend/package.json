{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{vue,ts,js,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
